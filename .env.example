# document-qa-server 运行配置示例。
# 复制为 .env 后修改；全部带默认值，不配置即使用当前默认行为。

# 监听地址与端口
DQA_HOST=127.0.0.1
DQA_PORT=8765

# 产物目录（上传/渲染/复核记录/Profile 保存）
DQA_ARTIFACTS_DIR=webapp-artifacts

# 服务器样例目录（界面"从服务器样例选择"下拉的数据源）
DQA_SAMPLES_DIR=examples

# 单文件上传上限（字节，默认 100 MiB）
DQA_MAX_UPLOAD_BYTES=104857600

# 允许访问 API 的前端来源（JSON 数组）；生产环境必须显式收紧
DQA_CORS_ORIGINS=["http://127.0.0.1:5180","http://localhost:5180"]

# 比较任务模式：true 为后台任务 + 轮询，false 为同步兼容路径
DQA_ASYNC_MODE=true

# 持久化日志：默认写入 DQA_ARTIFACTS_DIR/logs，按天轮转
DQA_LOG_FILE_ENABLED=true
# DQA_LOG_DIR=/absolute/path/to/logs
DQA_LOG_RETENTION_DAYS=14

# 图片内部文字 OCR（需 uv sync --extra ocr-paddle；默认关闭）
DQA_OCR_ENABLED=false
DQA_OCR_PROVIDER=paddle
DQA_OCR_DEVICE=cpu
DQA_OCR_LANGUAGE=ch
DQA_OCR_VERSION=PP-OCRv6
# 留空时模型缓存到 DQA_ARTIFACTS_DIR/ocr-cache
# DQA_OCR_CACHE_DIR=/absolute/path/to/ocr-cache
# 可选：使用已下载的检测/识别模型目录
# DQA_OCR_DETECTION_MODEL_DIR=/absolute/path/to/detection-model
# DQA_OCR_RECOGNITION_MODEL_DIR=/absolute/path/to/recognition-model
